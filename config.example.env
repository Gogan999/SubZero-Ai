# SubZero AI settings
#
# On the mini PC, config.env lives in C:\ProgramData\SubZeroAI. The installer puts a copy there and the
# setup page (http://localhost:8787/setup) fills in the address, Slack, and Claude settings for you.
# Settings changed later on the admin Settings page are saved in the database and win over this file.
# Lines starting with # are notes. Keep config.env private: it holds the Claude API key and Slack tokens.
# After editing, run:  python -m subzero_ai check   (or double-click check-settings.cmd)

# ---------------------------------------------------------------------------- Address
# The address people use to reach the app through the Cloudflare Tunnel.
PUBLIC_URL=https://ai.yourdomain.org
# The app only listens on this PC. Change the port only if 8787 is taken (then update the tunnel too).
HOST=127.0.0.1
PORT=8787

# ------------------------------------------------------------------------------- Team
APP_NAME=SubZero AI
# Used for "today" in the daily limit and for the times shown in the app.
TIMEZONE=America/Chicago

# ----------------------------------------------------------------------------- Claude
# Create the key inside the SubZero AI workspace at platform.claude.com (Settings, API keys),
# so the workspace's monthly spend limit applies to it.
ANTHROPIC_API_KEY=
MODEL_DEFAULT=claude-sonnet-5-5
# Mentors can switch a chat to this model for hard problems. It costs about twice as much.
MODEL_HARD=claude-opus-5-5
# Writes the short chat titles.
MODEL_TITLES=claude-haiku-5-5
# How much effort Claude puts into each reply: low, medium, or high. Higher costs more.
EFFORT_DEFAULT=medium
# Effort for interactive explainers and messages with files attached (usually code reviews).
EFFORT_HIGH=high
# Longest reply, in tokens (about 6,000 words).
MAX_TOKENS_CHAT=8000
# Longest reply when a student asks for an interactive explainer, which is a whole web page.
MAX_TOKENS_EXPLAINER=16000
# Once a chat sends Claude more than this many tokens per reply, the app suggests starting a fresh chat.
LONG_CHAT_TOKENS=150000
# 1 gives canned replies and needs no API key (for trying the app). Use 0 for real answers.
FAKE_CLAUDE=0
# Which AI engine answers: anthropic (the default), pi (through the Node.js helper in pi_gateway), or fake
# (canned replies, no key needed). FAKE_CLAUDE=1 still works and wins over this.
AI_BACKEND=anthropic
# Only for AI_BACKEND=pi. Node.js 22.19 or newer: "node", or the full path to node.exe.
PI_NODE=node
# Leave empty to use pi_gateway/gateway.mjs from this install.
PI_GATEWAY_SCRIPT=
# Seconds for a whole reply, and the longest quiet gap in the middle of one, before the app gives up.
PI_REQUEST_TIMEOUT=300
PI_IDLE_TIMEOUT=120

# ------------------------------------------------------------------------------ Slack
# Bot token, starts with xoxb-. Slack app settings, OAuth & Permissions, after Install to Workspace.
SLACK_BOT_TOKEN=
# App-level token with the connections:write scope, starts with xapp-. Basic Information, App-Level Tokens.
SLACK_APP_TOKEN=
# Basic Information, App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# The channel ID of the private #claude-approvals channel (starts with C or G).
# In Slack, open the channel, click its name at the top, and copy the Channel ID at the bottom.
# Invite the app to the channel first by typing:  /invite @SubZero AI
SLACK_APPROVALS_CHANNEL=
# Slack member IDs of the coaches, separated by commas. Admins also see the audit log.
# In Slack, click a person's name, open the three-dot menu, and choose Copy member ID.
ADMIN_SLACK_IDS=
# Optional. Normally read from the bot token.
SLACK_TEAM_ID=
# 1 lets Slack guest accounts (single- and multi-channel guests) sign in. They could then read
# every approved team chat. Leave it at 0 unless students are guests in your workspace.
ALLOW_SLACK_GUESTS=0

# --------------------------------------------------------------------- Approval rules
# 1 means mentors' own messages also wait for another mentor.
MENTORS_NEED_APPROVAL=0
LIMIT_PENDING_PER_STUDENT=3
LIMIT_APPROVED_PER_DAY=25
# Post one reminder in the card's Slack thread after this many minutes.
REMINDER_MINUTES=120
# 1 lets other students see messages that are still waiting for review.
SHOW_PENDING_TO_TEAM=0
# 1 lets other students see rejected messages and the reason.
SHOW_REJECTED_TO_TEAM=0
# After a mentor approves a message, the student's next messages in that chat go straight to
# Claude until they stop chatting for this many minutes. The first message of every chat and
# messages with files always wait. 0 means every message waits.
APPROVAL_WINDOW_MINUTES=5
# Slack member IDs of students who always wait for a mentor, separated by commas.
ALWAYS_REVIEW_SLACK_IDS=
# 1 has a small model check each message in the window first. Anything it flags, or anything
# it can't check, waits for a mentor.
SCREENER_ENABLED=1
MODEL_SCREENER=claude-haiku-5-5

# -------------------------------------------------------------------------- Attachments
# Students can attach up to 5 files of up to 5 MB each. Text and code files are also capped at
# this many KB, because Claude reads every line of them on every reply (200 KB is about 50,000 tokens).
MAX_TEXT_FILE_KB=200

# Subteams students pick from, separated by commas.
SUBTEAMS=Programming,Fab and design,Business and outreach

# ------------------------------------------------------------------------- Connectors
# The composer's tools menu can add files from the team's GitHub repository. Admins can also set
# these on the Settings page. CONNECTOR_GITHUB_TOKEN is only needed for a private repository: make a
# fine-grained token for just that repository with read-only "Contents" access.
CONNECTOR_GITHUB_REPO=
CONNECTOR_GITHUB_BRANCH=
CONNECTOR_GITHUB_TOKEN=
# Lets people add a Google Doc, Sheet, Slides deck or Drive file shared as "Anyone with the link".
CONNECTOR_DRIVE_LINKS=true

# ------------------------------------------------------------------------ Data and backups
# Delete chats with no activity for this many days (730 keeps this season and the next). 0 keeps them forever.
RETENTION_DAYS=730
# Nightly backups go here. Leave blank for C:\ProgramData\SubZeroAI\backups, or use a folder that OneDrive or
# Google Drive syncs for an off-site copy. Backups never include this file.
BACKUP_DIR=
# Hour of the nightly backup (0-23, local time), and how many days of backups to keep.
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# The admin page says when this GitHub repository has a newer release. 0 turns the daily check off.
CHECK_FOR_UPDATES=1

# ---------------------------------------------------------------------------- Testing
# 1 adds sample sign-ins that work only on this PC. Never leave it on once students use the app.
DEV_LOGIN=0
